# ============================================================
# TWFA - Trading Environment Variables
# Copy this file to .env and fill in your actual values
# ============================================================

# --- MetaTrader 5 (JustMarkets) ---
MT5_LOGIN=00000000
MT5_PASSWORD=your_password
MT5_SERVER=JustMarkets-Live
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# --- Broker credentials (for ccxt / API access) ---
# Crypto exchanges (example: binance)
BINANCE_API_KEY=your_api_key
BINANCE_API_SECRET=your_api_secret

# --- Risk Management ---
MAX_RISK_PER_TRADE=0.02
MAX_OPEN_POSITIONS=5
MAX_DAILY_LOSS=0.05
STOP_LOSS_PIPS=30
TAKE_PROFIT_PIPS=60

# --- Trading Schedule ---
TRADING_SESSION_START=00:00
TRADING_SESSION_END=23:59

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/trading.log
