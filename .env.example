# ============================================================
# TWFA - Trading Environment Variables
# Copy this file to .env and fill in your actual values
# ============================================================

# --- MetaTrader 5 (JustMarkets) ---
MT5_LOGIN=00000000
MT5_PASSWORD=your_password
MT5_SERVER=JustMarkets-Live
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# --- Broker credentials (for ccxt / API access) ---
# Crypto exchanges (example: binance)
BINANCE_API_KEY=your_api_key
BINANCE_API_SECRET=your_api_secret

# --- Risk Management ---
MAX_RISK_PER_TRADE=0.02
MAX_OPEN_POSITIONS=5
MAX_DAILY_LOSS=0.05
STOP_LOSS_PIPS=30
TAKE_PROFIT_PIPS=60

# --- Trading Schedule ---
TRADING_SESSION_START=00:00
TRADING_SESSION_END=23:59

# ── AI Provider ─────────────────────────────────────────────────────────────
# Choose provider: anthropic | nvidia | gemini | openrouter
AI_PROVIDER=anthropic

# Model identifier (provider-dependent):
# Anthropic: claude-sonnet-4-20250514
# NVIDIA NIM: nvidia/llama-3.3-70b-instruct (fast, general purpose)
# nvidia/nemotron-3-ultra-550b-a55b (larger, deeper reasoning)
# nvidia/qwen2.5-72b-instruct (strong multilingual)
# Gemini: gemini-2.5-flash-preview-04-17 (fast, low latency)
# gemini-2.5-pro (best quality, slower)
# OpenRouter: meta-llama/llama-4-maverick (default OpenRouter)
# deepseek/deepseek-chat (strong reasoning)
# google/gemini-2.5-pro-exp-03-25
AI_MODEL=claude-sonnet-4-20250514

# NVIDIA-only options:
AI_STREAM=false    # stream responses token-by-token (NVIDIA only)
AI_REASONING_BUDGET=0  # extended CoT tokens for reasoning models (0=off)
AI_MAX_TOKENS=500  # max tokens per response (reduce for speed)

# ── AI per-use-case overrides (optional) ────────────────────────────────
# By default both "suggest" (trade signals) and "chat" (research terminal)
# use the global settings above. Uncomment + fill any overrides you need:
# AI_SUGGEST_MODEL=             # override model for trade suggestions only
# AI_SUGGEST_MAX_TOKENS=        # override max_tokens for suggestions only
# AI_SUGGEST_REASONING_BUDGET=  # override reasoning_budget for suggestions only
# AI_CHAT_MODEL=                # override model for research terminal only
# AI_CHAT_MAX_TOKENS=           # override max_tokens for chat only
# AI_CHAT_REASONING_BUDGET=     # override reasoning_budget for chat only
# AI_CHAT_STREAM=               # override stream setting for chat only

# API keys (fill in only the one(s) you use):
#ANTHROPIC_API_KEY=
#NVIDIA_API_KEY=
#GEMINI_API_KEY=
#OPENROUTER_API_KEY=

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/trading.log
